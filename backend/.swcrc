{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "emitDecoratorMetadata": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2021",
    "externalHelpers": true
  },
  "module": {
    "type": "commonjs",
    "strict": true,
    "noInterop": false
  }
}
