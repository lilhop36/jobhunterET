generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  locale              String               @default("en")
  notificationsPaused Boolean              @default(false)
  matchThreshold      Int                  @default(65)
  pausedUntil         DateTime?
  createdAt           DateTime             @default(now())
  digestEnabled       Boolean              @default(true)
  emailVerifiedAt     DateTime?
  lastActiveAt        DateTime?
  status              UserStatus           @default(ACTIVE)
  tokenInvalidatedAt  DateTime?
  applications        Application[]
  profile             CandidateProfile?
  skills              CandidateSkill[]
  cvFiles             CvFile[]
  digests             Digest[]
  matches             JobMatch[]
  applicationPackages ApplicationPackage[]
  locations           LocationPreference[]
  notifications       Notification[]
  searches            SearchProfile[]
  targetRoles         TargetRole[]
  telegramLink        TelegramLink?
  education           CandidateEducation[]
  experiences         CandidateExperience[]
  projects            CandidateProject[]
  certifications      CandidateCertification[]
  languages           CandidateLanguage[]

  @@index([status, lastActiveAt])
}

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  title           String?
  summary         String?
  // Personal details — confirmed by the candidate, never inferred silently
  fullName        String?
  phone           String?
  city            String?
  country         String?  @default("Ethiopia")
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  years           Int      @default(0)
  remote          Boolean  @default(false)
  minSalary       Int      @default(0)
  excludeOnsite   Boolean  @default(false)
  excludeEntryLevel Boolean @default(false)
  employmentTypes String[] @default([])
  onboardDone     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateEducation {
  id          String @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  grade       String?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateExperience {
  id          String  @id @default(cuid())
  userId      String
  title       String
  company     String
  location    String?
  startYear   Int?
  endYear     Int?
  current     Boolean @default(false)
  description String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateProject {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  url         String?
  year        Int?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateCertification {
  id            String  @id @default(cuid())
  userId        String
  name          String
  issuer        String?
  year          Int?
  credentialUrl String?
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateLanguage {
  id          String @id @default(cuid())
  userId      String
  language    String
  // NATIVE | FLUENT | INTERMEDIATE | BASIC
  proficiency String @default("INTERMEDIATE")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

model CvFile {
  id           String   @id @default(cuid())
  userId       String
  filePath     String
  originalName String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())
  active       Boolean  @default(true)
  // CV | CERTIFICATE | PORTFOLIO | OTHER
  kind         String   @default("CV")
  label        String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, kind])
}

model TelegramLink {
  id       String             @id @default(cuid())
  userId   String             @unique
  chatId   String             @unique
  linkedAt DateTime           @default(now())
  status   TelegramLinkStatus @default(ACTIVE)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id    String           @id @default(cuid())
  name  String           @unique
  users CandidateSkill[]
  jobs  JobSkill[]
}

model CandidateSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model TargetRole {
  id       String   @id @default(cuid())
  userId   String
  role     String
  priority Priority
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LocationPreference {
  id     String   @id @default(cuid())
  userId String
  region String
  tier   Priority
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, region])
}

model JobSource {
  id                  String       @id @default(cuid())
  name                String
  type                SourceType
  baseUrl             String
  status              SourceStatus @default(ACTIVE)
  priorityTier        SourceTier
  collectionFrequency String       @default("30 min")
  lastSuccessfulRun   DateTime?
  lastFailedRun       DateTime?
  lastError           String?
  createdAt           DateTime     @default(now())
  consecutiveFailures Int          @default(0)
  // Source Resilience: per-source health scoring (last 10 runs)
  healthScore         Float?       @map("health_score")
  lastHealthCheckAt   DateTime?    @map("last_health_check_at")
  jobs                Job[]
  runs                SourceRun[]
  listings            JobSourceListing[]

  @@map("JobSource")
}

/// One original posting on one board. A Job is the canonical opportunity; when
/// the same opening is advertised on several boards each board keeps its own
/// listing row, so every original link survives deduplication.
model JobSourceListing {
  id          String    @id @default(cuid())
  jobId       String
  sourceId    String
  sourceJobId String
  url         String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceJobId])
  @@index([jobId])
}

model SourceRun {
  id                    String    @id @default(cuid())
  sourceId              String
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  status                String
  jobsFetched           Int       @default(0)
  jobsCreated           Int       @default(0)
  duplicates            Int       @default(0)
  errors                Int       @default(0)
  errorMessage          String?
  avgDescriptionQuality Float?
  descriptionFailures   Int       @default(0)
  linkChecks            Int       @default(0)
  linkFailures          Int       @default(0)
  mode                  String    @default("FAST")
  pagesFetched          Int       @default(0)
  categoriesSearched    Int       @default(0)
  crossCategoryDuplicates Int     @default(0)
  unmappedCategories    Int       @default(0)
  categoryStats         SourceRunCategory[]
  source                JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model SourceRunCategory {
  id            String    @id @default(cuid())
  runId         String
  sourceId      String
  category      String
  categoryLabel String?
  pagesFetched  Int       @default(0)
  jobsFetched   Int       @default(0)
  newJobs       Int       @default(0)
  duplicates    Int       @default(0)
  errors        Int       @default(0)
  stoppedReason String?
  run           SourceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([sourceId, category])
  @@index([runId])
}

model Job {
  id                   String             @id @default(cuid())
  title                String
  description          String?
  company              String
  location             String
  workPlace            Workplace          @default(ONSITE)
  locationClass        LocationClass
  employmentType       EmploymentType
  experienceLevel      ExperienceLevel
  salary               Int?
  currency             String             @default("USD")
  url                  String
  sourceId             String
  sourceJobId          String?
  postedDate           DateTime
  deadline             DateTime?
  firstSeenAt          DateTime           @default(now())
  lastSeenAt           DateTime           @default(now())
  missedCycles         Int                @default(0)
  status               JobStatus          @default(ACTIVE)
  statusChangedAt      DateTime?
  parseConfidence      Int                @default(85)
  archivedAt           DateTime?
  fingerprint          String?
  rawData              Json?
  country              String?
  createdAt            DateTime           @default(now())
  matchedAt            DateTime?
  urlCheckedAt         DateTime?
  urlStatus            String?
  applyEmail           String?
  applyMethod          ApplyMethod        @default(ONLINE_URL)
  applyUrl             String?
  applyUrlRaw          String?
  descriptionFetchedAt DateTime?
  descriptionQuality   Int?
  descriptionSource    DescriptionSource?
  finalUrl             String?
  tags                 Json?
  categories            Json?
  // Ethiopia-only ingestion policy: ELIGIBLE | REVIEW | REJECTED
  eligibility           String          @default("REVIEW")
  eligibilityReason     String?
  // Cross-source deduplication key (normalized company|title|location). Two
  // boards advertising the same opening share it, so one canonical Job serves
  // both listings.
  crossSourceKey        String?
  apps                 Application[]
  source               JobSource          @relation(fields: [sourceId], references: [id])
  matches              JobMatch[]
  skills               JobSkill[]
  notifications        Notification[]
  listings             JobSourceListing[]
  applicationPackages  ApplicationPackage[]

  @@unique([sourceId, sourceJobId])
  @@index([status])
  @@index([status, postedDate])
  @@index([firstSeenAt])
  @@index([status, matchedAt])
  @@index([status, deadline])
  @@index([status, urlStatus])
  @@index([eligibility])
  @@index([crossSourceKey])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model JobMatch {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  score           Int
  roleScore       Float
  skillScore      Float
  experienceScore Float
  locationScore   Float
  employmentScore Float
  freshnessScore  Float
  salaryScore     Float
  matchedSkills   String[]
  relatedSkills   String[]
  missingSkills   String[]
  reasons         String[]
  summary         String?
  requiredRequirements  String[] @default([])
  preferredRequirements String[] @default([])
  missingRequirements   String[] @default([])
  unknownRequirements   String[] @default([])
  evidence              String[] @default([])
  vacancyRisk     String   @default("OK")
  matcherVersion  String   @default("v2.2-rules")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([userId, score])
}

model ApplicationPackage {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  version   Int
  content   String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, version])
  @@index([userId, jobId])
}

model Application {
  id          String                  @id @default(cuid())
  userId      String
  jobId       String
  stage       ApplicationStage        @default(APPLIED)
  stageSince  DateTime                @default(now())
  followUp    DateTime?
  version     Int                     @default(1)
  job         Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transitions ApplicationTransition[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([userId, stage])
}

model ApplicationTransition {
  id             String            @id @default(cuid())
  applicationId  String
  fromStage      ApplicationStage?
  toStage        ApplicationStage
  transitionedAt DateTime          @default(now())
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, transitionedAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  jobId     String
  channel   NotificationChannel
  status    NotificationStatus  @default(UNREAD_WEB)
  score     Int
  summary   String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?
  job       Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, channel, status])
}

model SearchProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  q         String?
  tier      String   @default("ALL")
  remote    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Digest {
  id            String   @id @default(cuid())
  userId        String
  createdAt     DateTime @default(now())
  jobsCollected Int
  newJobs       Int
  strongMatches Int
  topMatches    Json
  searches      Json
  deliveredTo   String   @default("WEB")
  status        String   @default("SENT")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MatchCycle {
  id                  String    @id @default(cuid())
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  jobsEvaluated       Int
  usersProcessed      Int
  matchesCreated      Int
  aboveThreshold      Int
  notificationsSent   Int       @default(0)
  notificationsFailed Int       @default(0)
  toInbox             Int       @default(0)
  errors              Int       @default(0)
  actionsTaken        Int       @default(0)
}

model SystemLog {
  id  String   @id @default(cuid())
  tag String
  msg String
  at  DateTime @default(now())

  @@index([at])
}

model BotState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DORMANT
  DISABLED
  DELETED
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  PART_TIME
  INTERNSHIP
}

enum ExperienceLevel {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
}

enum LocationClass {
  ETHIOPIA_LOCAL
  ETHIOPIA_REMOTE
  INTERNATIONAL_REMOTE
  INTERNATIONAL_ONSITE
  INTERNATIONAL_HYBRID
}

enum Workplace {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum NotificationChannel {
  TELEGRAM
  WEB
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  UNREAD_WEB
  READ
}

enum ApplicationStage {
  DISCOVERED
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum SourceStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum SourceTier {
  ETHIOPIA
  REMOTE
  INTERNATIONAL
}

enum TelegramLinkStatus {
  ACTIVE
  UNREACHABLE
}

enum ApplyMethod {
  ONLINE_URL
  EMAIL
  IN_PERSON
  SOURCE_ACCOUNT
  PDF_FORM
}

enum DescriptionSource {
  API
  LIST
  DETAIL
  PDF
}

enum SourceType {
  API
  RSS
  JSON
  HTML
  COMPANY_CAREER_PAGE
  TELEGRAM
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}
