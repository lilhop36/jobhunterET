{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": false,
    "assets": [
      { "include": "**/knowledge-base.json", "outDir": "dist" },
      { "include": "**/source-configs.json", "outDir": "dist" },
      { "include": "**/category-taxonomy.json", "outDir": "dist" },
      { "include": "**/source-categories.json", "outDir": "dist" }
    ]
  }
}
