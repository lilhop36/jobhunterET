# ══════════════════════════════════════════════════════════════
# JobHunter Backend — Environment Variables
# SRS v2.3 §31 + Phase 0 additions
# Copy to .env and fill in real values. Never commit .env.
# ══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
PORT=3210
# $0 BUDGET DEFAULT: SQLite for dev — zero infrastructure required.
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production): DATABASE_URL="postgresql://jobhunter:jobhunter@localhost:5432/jobhunter?schema=public"
REDIS_URL=""                          # Phase 2 (BullMQ) — reserved, unused in MVP

# ── Authentication & Security ─────────────────────────────────
# REQUIRED — backend refuses to boot without it (SEC-001).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

# First-user auto-promotion: if non-empty, ONLY these emails become ADMIN.
# If empty, the first registered user becomes ADMIN (FR-001).
ADMIN_EMAILS="admin@jobhunter.et"

# Optional: registration requires this code. Leave empty to disable (FR-002g).
REGISTRATION_INVITE_CODE=""

# Rate limiting — in-memory, single-instance MVP (SEC-005)
AUTH_RATE_MAX=10                      # per-IP attempts per window (login/register/password)
AUTH_EMAIL_RATE_MAX=5                 # per-account login attempts per window
AUTH_RATE_WINDOW_MS=900000            # 15 min

# CORS — comma-separated origins; ignored in dev mode (allows all)
CORS_ORIGIN="http://localhost:3211"
LINK_RATE_MAX=20                      # web link-code validations per user per 15 min
LINK_CODE_RATE_MAX=10                 # bot /start code attempts per chat per 10 min

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""                 # from @BotFather
TELEGRAM_BOT_USERNAME="JobHunterBot"
TELEGRAM_GLOBAL_RATE_PER_SEC=25       # FR-024b global rate cap
TELEGRAM_PER_CHAT_INTERVAL_MS=1200    # FR-024b per-chat minimum interval

# ── Matching Engine ───────────────────────────────────────────
MATCH_THRESHOLD=65                    # FR-019 default threshold
FRESHNESS_TAU_HOURS=72                # FR-019b decay time constant (hours)
INCREMENTAL_MATCH_LIMIT=250           # FR-018 batch: max unmatched ACTIVE jobs per cycle
RECALC_JOB_LIMIT=1000                 # FR-003e recalc: most recent ACTIVE jobs on profile update

# ── Collection & Scheduling ───────────────────────────────────
JOB_COLLECTION_INTERVAL=30m           # FR-035 scheduled collection (accepts ms or "30m")
DEEP_COLLECTION_INTERVAL=60m         # FR-035b deep collection cadence (accepts ms or "60m")
MATCH_CYCLE_INTERVAL=35m              # matching cycle interval
EXPIRATION_SWEEP_INTERVAL=6h          # FR-034a expiry sweep
DIGEST_INTERVAL=24h                   # FR-028 daily digest schedule
RETENTION_INTERVAL=24h                # nightly retention archive
BACKUP_INTERVAL=24h                   # nightly backup

# ── Job Pipeline ──────────────────────────────────────────────
URL_MAX_REDIRECTS=3                   # FR-012f max redirects during link check
MIN_DESCRIPTION_CHARS=300             # FR-012d below this triggers detail rescue
MAX_DESCRIPTION_CHARS=8000            # hard cap on description storage
URL_CHECK_AT_INGEST=on                # set to "off" to skip URL liveness at ingest
DEADLINE_DEFAULT_TZ="Africa/Addis_Ababa"  # FR-034a fallback timezone

# ── Lifecycle ─────────────────────────────────────────────────
RETENTION_DAYS=90                     # §25.2 job retention before archiving
DORMANT_AFTER_DAYS=30                 # FR-003d2 dormancy threshold
LINK_ROT_MAX_PER_CYCLE=200            # FR-034c daily link-rot check cap
NOTIFICATION_RETENTION_DAYS=90        # notification cleanup
LOG_RETENTION_DAYS=30                 # system log cleanup

# ── File Storage ──────────────────────────────────────────────
CV_UPLOAD_DIR="./uploads/cv"          # FR-003a outside web root
CV_MAX_SIZE_MB=5                      # FR-003a max CV size

# ── App ───────────────────────────────────────────────────────
APP_URL="https://app.jobhunter.et"    # base URL for digest/telegram links

# ── Dev / Seed ────────────────────────────────────────────────
SEED_DEMO_DATA=false                  # prisma/seed.ts refuses to run unless true
