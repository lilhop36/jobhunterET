# JobHunter configuration — mirrors SRS v2.2 §31. Secrets are never committed.
# Copy to .env and fill in real values.

DATABASE_URL="postgresql://jobhunter:jobhunter@localhost:5432/jobhunter?schema=public"
REDIS_URL=""                      # Phase 2 (BullMQ) — reserved, unused in MVP

# REQUIRED - the backend refuses to boot without it (SEC-001).
# Generate a strong secret with Node crypto.randomBytes(48) and paste it here.
# The value below is a placeholder ONLY - never run with it in any deployment.
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

ADMIN_EMAILS="admin@jobhunter.et"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="JobHunterBot"
TELEGRAM_GLOBAL_RATE_PER_SEC=25
TELEGRAM_PER_CHAT_INTERVAL_MS=1200

CV_UPLOAD_DIR="./uploads/cv"
CV_MAX_SIZE_MB=5

JOB_COLLECTION_INTERVAL=30m        # FR-035 scheduled collection (accepts ms or "30m")
MATCH_THRESHOLD=70
PARSE_CONFIDENCE_MIN=40
GHOST_MISSED_CYCLE_LIMIT=3
EXPIRATION_SWEEP_INTERVAL=6h
RETENTION_DAYS=90
RECALC_JOB_LIMIT=1000

# --- Operational extras (not in SRS §31) ---
DIGEST_INTERVAL=24h                # FR-028 daily digest schedule (accepts ms or "24h")
APP_URL="https://app.jobhunter.et" # base URL used in digest/telegram links
SEED_DEMO_DATA=false               # dev-only: prisma/seed.ts refuses to run unless true

INCREMENTAL_MATCH_LIMIT=250              # FR-018 batch: max unmatched ACTIVE jobs scored per cycle/collect pass

# --- SEC-005 rate limiting (in-memory, single-instance MVP) ---
AUTH_RATE_MAX=10                       # per-IP attempts per window (login/register/password)
AUTH_EMAIL_RATE_MAX=5                  # per-account login attempts per window
AUTH_RATE_WINDOW_MS=900000             # 15 min
LINK_RATE_MAX=20                       # web link-code validations per user per 15 min
LINK_CODE_RATE_MAX=10                  # bot /start code attempts per chat per 10 min

# --- SEC-006 source retry ---
SOURCE_BACKOFF_THRESHOLD=3             # consecutive failures before backoff starts (1h, 2h, 4h... cap 24h)
