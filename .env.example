# ══════════════════════════════════════════════════════════════
# JobHunter — Root Port Configuration
# Single source of truth for all port numbers.
# Change once here → applies everywhere.
# ══════════════════════════════════════════════════════════════

FRONTEND_PORT=3211
BACKEND_PORT=3210
POSTGRES_PORT=5432

# ── Production ────────────────────────────────────────────────
# Set this to your backend URL for Vercel deployments.
# In dev, Next.js rewrites proxy /api/* to localhost:3210 automatically.
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
