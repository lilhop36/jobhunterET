{
  "name": "jobhunter",
  "version": "1.0.0",
  "private": true,
  "description": "JobHunter — Intelligent Job Search & Notification System",
  "scripts": {
    "dev": "concurrently -n FE,BE -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "test": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend",
    "db:sqlite": "npm run db:sqlite --prefix backend",
    "db:pg": "npm run db:pg --prefix backend",
    "db:switch": "npm run db:switch --prefix backend",
    "db:migrate": "npm run db:migrate:safe --prefix backend",
    "db:baseline": "npm run db:baseline --prefix backend",
    "db:backup": "npm run db:backup --prefix backend",
    "duplicates:report": "npm run duplicates:report --prefix backend",
    "smoke": "bash backend/scripts/smoke-test.sh",
    "nfr:check": "npm run nfr:check --prefix backend",
    "live:verify": "npm run smoke && npm run nfr:check",
    "facts:generate": "node scripts/generate-architecture-facts.js",
    "facts:check": "node scripts/generate-architecture-facts.js --check",
    "traceability:generate": "node scripts/generate-traceability.js",
    "traceability:check": "node scripts/generate-traceability.js --check",
    "arch:check": "node scripts/check-architecture-health.js --strict",
    "arch:verify": "npm run facts:check && npm run traceability:check && npm run arch:check"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
